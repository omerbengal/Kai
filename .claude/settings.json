{
  "mcpServers": {
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "D:/Nova/nova.db"
      ]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "<YOUR_BRAVE_API_KEY>"
      }
    },
    "telegram": {
      "command": "D:/Nova/.venv/Scripts/telegram-mcp-server.exe",
      "env": {
        "TELEGRAM_BOT_TOKEN": "${KAI_TELEGRAM_BOT_TOKEN}",
        "TELEGRAM_CHAT_ID": "${KAI_TELEGRAM_CHAT_ID}"
      }
    },
    "whatsapp": {
      "command": "D:/Nova/.venv/Scripts/python.exe",
      "args": ["D:/Nova/whatsapp-mcp/main.py"]
    }
  }
}
