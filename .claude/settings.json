{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/Kai/scripts/patch_telegram_plugin.py",
            "async": false
          },
          {
            "type": "command",
            "command": "python D:/Kai/scripts/session_start_cleanup.py || true",
            "async": true
          },
          {
            "type": "command",
            "command": "python D:/Kai/scripts/session_handoff_notify.py || true",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/Kai/scripts/save_telegram_message.py --mode outgoing",
            "async": true
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram_telegram__react",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/Kai/scripts/save_reaction.py",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/Kai/scripts/inject_critical_rules.py",
            "async": false
          },
          {
            "type": "command",
            "command": "python D:/Kai/scripts/save_telegram_message.py --mode incoming",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/Kai/scripts/on_compact.py",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python D:/Kai/scripts/on_compact.py",
            "async": true
          }
        ]
      }
    ]
  },
  "env": {
    "GROQ_API_KEY": "<REDACTED_GROQ_KEY>",
    "SUPADATA_API_KEY": "<REDACTED_SUPADATA_KEY>"
  },
  "mcpServers": {
    "telegram": {
      "command": "D:/Kai/.venv/Scripts/telegram-mcp-server.exe",
      "env": {
        "TELEGRAM_BOT_TOKEN": "${KAI_TELEGRAM_BOT_TOKEN}",
        "TELEGRAM_CHAT_ID": "${KAI_TELEGRAM_CHAT_ID}"
      }
    },
    "whatsapp": {
      "command": "uv",
      "args": [
        "--directory",
        "D:/Kai/whatsapp-mcp/whatsapp-mcp-server",
        "run",
        "main.py"
      ]
    }
  }
}
